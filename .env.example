# Copy to .env only if you run the services outside Docker (npm run start:dev).
# docker-compose.yml already sets these for the containers.

# Postgres (one instance, one database per service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka: use localhost:29092 from your machine, kafka:9092 from inside Docker
KAFKA_BROKERS=localhost:29092

# Service URLs used by the gateway and by order-service
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

SEED_PRODUCTS=true
